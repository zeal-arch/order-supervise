# ==============================================
# Order Supervisor - Environment Configuration
# ==============================================

# Database Configuration (SQLite by default for zero-setup local execution)
DATABASE_URL=sqlite+aiosqlite:///./order_supervisor.db
DATABASE_SYNC_URL=sqlite:///./order_supervisor.db

# Temporal Server Configuration
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=order-supervisor-task-queue

# Backend API Configuration
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Configuration (Optional - autonomous rule engine fallback runs with zero API keys)
LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# Next.js Web Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
